Text:
This design is about which folders of a desk are 'well shaped'.
A Zip models what a zip file holds.
fearlessProject.zip(Desk, File), fearlessProject.len(Desk, Segment), fearlessProject.isHidden(Desk, Segment), fearlessProject.isZip(Desk, Segment), fearlessProject.isZipOf(Desk, Segment, Segment'), fearlessProject.folderNameOk(Desk, Segment), fearlessProject.fileNameOk(Desk, Segment), fearlessProject.hiddenNameOk(Desk, Segment), fearlessProject.okTogether(Desk, Segment, Segment') and fearlessProject.timeOk(Desk, File) have no Notation.
//later: the Notations of those ten

Grammar:
Zip ::= "Zip{" ZipEntries "}"
ZipEntries ::= ZipEntry1 .. ZipEntryn
ZipEntry ::= Segment "->" Zip | Segment "->" File
Thing ::= Element | Zip
Visibility ::= "visible" | "hidden"
Nat ::= [0-9]+

Notation: fearlessProject.names(Desk, Id) = Entries where:
- Desk = Ids ";" Folders Id "{" Entries "}" Folders'

Notation: fearlessProject.names(Desk, "Zip{" ZipEntries "}") = ZipEntries

Notation: fearlessProject.wellShaped(Desk, DeskPath) where:
- Desk.at(DeskPath) = Id
- fearlessProject.names(Desk, Id) is not empty
- fearlessProject.ok(Desk, fearlessProject.names(Desk, Id), "visible", 0, 0)

Notation: fearlessProject.ok(Desk, Segment1 "->" Thing1 .. Segmentn "->" Thingn, Visibility, Nat, Nat') where:
- for each i, j in 1..n with i != j: fearlessProject.okTogether(Desk, Segmenti, Segmentj)
- if Visibility is "visible": for each i, j in 1..n where not fearlessProject.isHidden(Desk, Segmenti): not fearlessProject.isZipOf(Desk, Segmenti, Segmentj)
- for each i in 1..n: fearlessProject.okEntry(Desk, Segmenti, Thingi, Visibility, Nat + fearlessProject.len(Desk, Segmenti), Nat')

Notation: fearlessProject.okEntry(Desk, Segment, Thing, "visible", Nat, Nat') where:
- not fearlessProject.isHidden(Desk, Segment)
- Nat <= 200
- Thing is of form Zip, or Thing is of form Id and Thing is not one of the 'root ids' of Desk
- fearlessProject.folderNameOk(Desk, Segment)
- fearlessProject.names(Desk, Thing) is not empty
- fearlessProject.ok(Desk, fearlessProject.names(Desk, Thing), "visible", Nat + 1, Nat')

Notation: fearlessProject.okEntry(Desk, Segment, File, "visible", Nat, Nat') where:
- not fearlessProject.isHidden(Desk, Segment)
- Nat <= 200
- fearlessProject.fileNameOk(Desk, Segment)
- fearlessProject.timeOk(Desk, File)
- not fearlessProject.isZip(Desk, Segment)

Notation: fearlessProject.okEntry(Desk, Segment, File, "visible", Nat, Nat') where:
- not fearlessProject.isHidden(Desk, Segment)
- Nat <= 200
- fearlessProject.fileNameOk(Desk, Segment)
- fearlessProject.timeOk(Desk, File)
- fearlessProject.isZip(Desk, Segment)
- Nat' <= 64
- fearlessProject.zip(Desk, File) = Zip
- fearlessProject.names(Desk, Zip) is not empty
- fearlessProject.ok(Desk, fearlessProject.names(Desk, Zip), "visible", Nat - 3, Nat' + 1)

Notation: fearlessProject.okEntry(Desk, Segment, File, Visibility, Nat, Nat') where:
- Visibility is "hidden" or fearlessProject.isHidden(Desk, Segment)
- Nat <= 250
- fearlessProject.hiddenNameOk(Desk, Segment)

Notation: fearlessProject.okEntry(Desk, Segment, Thing, Visibility, Nat, Nat') where:
- Visibility is "hidden" or fearlessProject.isHidden(Desk, Segment)
- Nat <= 250
- Thing is of form Zip, or Thing is of form Id and Thing is not one of the 'root ids' of Desk
- fearlessProject.hiddenNameOk(Desk, Segment)
- if Visibility is "visible": fearlessProject.names(Desk, Thing) is not empty
- fearlessProject.ok(Desk, fearlessProject.names(Desk, Thing), "hidden", Nat + 1, Nat')
